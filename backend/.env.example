PORT=3000
# Cadena de conexión a MySQL para desarrollo (Base de datos principal)
DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/Notas_lab"

# Cadena de conexión a MySQL para la suite de pruebas aislada
TEST_DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/Notas_lab_test"

# Proveedor de IA (DeepSeek) - configure su API key privada aquí
DEEPSEEK_API_KEY=su_clave_api_aqui
DEEPSEEK_MODEL=deepseek-flash

# Tarifas configurables para estimación de costos (precio por millón de tokens en USD)
AI_PRICE_PER_MILLION_INPUT_TOKENS=0.14
AI_PRICE_PER_MILLION_OUTPUT_TOKENS=0.28

# Zona horaria para el cálculo del resumen diario (ej. America/Costa_Rica o UTC)
TIMEZONE=America/Costa_Rica
