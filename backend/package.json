{
  "name": "lab5-api-notas-claude-backend",
  "version": "1.0.0",
  "description": "Backend API REST para gestión de notas y sistema académico con Express 5, Swagger, Zod, Prisma ORM y MySQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test --test-concurrency=1",
    "seed": "node prisma/seed.js",
    "migrate:sqlite": "node scripts/migrate-sqlite-to-mysql.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "rest-api",
    "swagger",
    "zod",
    "prisma",
    "mysql"
  ],
  "author": "Integrante A",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.4",
    "openai": "^7.55.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2"
  }
}
